global
    log /dev/log local0
    maxconn 4096

defaults
    log global
    mode http
    timeout connect 5s
    timeout client 60s
    timeout server 60s

frontend zabbix_web
    bind *:80
    default_backend zabbix_web_nodes

backend zabbix_web_nodes
    balance roundrobin
    option httpchk GET /healthz
{% for host in groups['zabbix_servers'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:8080 check
{% endfor %}
